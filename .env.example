# ==========================================
# PUBLIC APP SETTINGS (Vite)
# ==========================================
# URL của Supabase project (bắt buộc đúng project production/staging)
VITE_SUPABASE_URL=https://ynmcoeapfycijblydyuw.supabase.co
# Key dùng cho frontend public (đọc auth, public data)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# URL chính thức của trang web để sinh các URL absolute
VITE_SITE_URL=https://academy.desembre.vn

# ==========================================
# BACKEND / NODE.JS / WORKER SETTINGS
# ==========================================
# Anon key dành cho các script ngoài browser (nếu cần)
SUPABASE_ANON_KEY=eyJhb...
# Service role key để bypass RLS (TUYỆT ĐỐI KHÔNG LỘ RA FRONTEND/PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ==========================================
# ZNS & OUTBOX HUB SETTINGS
# ==========================================
# URL trỏ về Hub Server
HUB_API_URL=http://localhost:5174
# Secret xác thực worker với Hub
HUB_WORKER_SECRET=dev-secret